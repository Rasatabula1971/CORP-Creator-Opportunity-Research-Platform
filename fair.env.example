# FAIR additional provider keys — copy to fair.env and fill in the values you have.
#
# fair.env is gitignored; THIS template is committed so the shape of the file
# is documented. Never commit real API keys.
#
# CORP passes GEMINI_API_KEY and GROQ_API_KEY to FAIR directly from its own
# .env, so do NOT duplicate them here. This file is for the extra free-tier
# providers FAIR can route to. Leave any line blank to skip that provider.
#
# Signup links (free tiers):
#   Mistral       https://console.mistral.ai/api-keys
#   OpenRouter    https://openrouter.ai/keys
#   KILO          https://kilocode.ai/
#   Z.AI          https://open.bigmodel.cn/
#   NVIDIA NIM    https://build.nvidia.com/
#   Ollama Cloud  https://ollama.com/
#   Cloudflare    https://developers.cloudflare.com/workers-ai/get-started/rest-api/

# Keys alone are not enough for the recurring free-tier providers (Gemini,
# Groq, Mistral, Z.ai, Cloudflare Workers AI): FAIR routes to them only when
# CORP's .env attests each account is free-only and cannot auto-bill, e.g.
#   FAIR_CONFIRMED_FREE_PROVIDERS=google_gemini_api,groq,mistral,zai_free,cloudflare_workers_ai
# Leave a provider off that list and FAIR skips it (GET /providers/health
# shows "skipped" with the reason). OpenRouter Free and Kilo Free need no
# confirmation: FAIR verifies a zero price on every call.
#
# NVIDIA NIM and Ollama Cloud are credit-priced and no longer eligible for
# FAIR's free-only routing; keys for them are ignored with a reason.

MISTRAL_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Cloudflare Workers AI needs both values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local Ollama (no key; discovered from the running daemon). Uncomment to enable.
# OLLAMA_HOST=http://localhost:11434
