# CORP Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://corp:corp@localhost:5432/corp
DATABASE_URL_SYNC=postgresql://corp:corp@localhost:5432/corp

# YouTube Data API v3
YOUTUBE_API_KEY=

# Google Gemini (free tier)
GEMINI_API_KEY=

# Rate limits
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_REQUESTS_PER_SECOND=5

# Scoring
SCORING_RULES_PATH=rules/scoring.yaml
INTENT_RULES_PATH=rules/intent.yaml

# App
APP_ENV=development
LOG_LEVEL=INFO
