# CORP Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://corp:corp@localhost:5432/corp
DATABASE_URL_SYNC=postgresql://corp:corp@localhost:5432/corp

# YouTube Data API v3
YOUTUBE_API_KEY=

# LLM provider: auto | fair | gemini  (auto prefers FAIR when FAIR_URL is set)
LLM_PROVIDER=auto

# FAIR Free AI Router (preferred: governed multi-provider free-tier routing)
FAIR_URL=http://localhost:8080
FAIR_CLIENT_ID=corp
FAIR_API_KEY=
FAIR_QUALITY_LEVEL=standard
FAIR_PRIORITY=P2
FAIR_TIMEOUT_SECONDS=60

# Google Gemini (free tier, fallback when FAIR_URL is unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Rate limits
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_REQUESTS_PER_SECOND=5

# yt-dlp metadata (YouTube fallback when YOUTUBE_API_KEY is empty; TikTok). No key needed.
YTDLP_MAX_ITEMS=50
YTDLP_INCLUDE_COMMENTS=false

# Creator-web adapter (platform "web", handle = URL of the creator hub/shop page)
WEB_MAX_PAGES=8

# Bulk research artifacts (raw JSONL archives from discovery runs). Point this at
# external storage (SD card / SSD); the database only stores a relative reference.
CORP_DATA_PATH=corp_data

# Reddit (public .json feeds, no API key). Keep the interval >= 6s unauthenticated.
REDDIT_USER_AGENT=corp-research/0.1 (creator opportunity research)
REDDIT_POSTS_PER_CREATOR=25
REDDIT_REQUEST_INTERVAL_SECONDS=6

# Scoring
SCORING_RULES_PATH=rules/scoring.yaml
INTENT_RULES_PATH=rules/intent.yaml

# App
APP_ENV=development
LOG_LEVEL=INFO
