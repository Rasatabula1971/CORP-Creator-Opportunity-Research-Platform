# CORP Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://corp:corp@localhost:5433/corp
DATABASE_URL_SYNC=postgresql://corp:corp@localhost:5433/corp

# YouTube Data API v3
YOUTUBE_API_KEY=

# LLM provider: auto | fair | gemini | groq | pool
# auto prefers FAIR (below) when the fair package is installed and FAIR_ENABLED=true;
# otherwise it pools every configured key below in LLM_PROVIDER_ORDER and fails
# over when one hits its quota.
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=gemini,groq
# Seconds a provider sits out after a daily-cap error (Gemini free tier: 20/day).
LLM_COOLDOWN_SECONDS=3600
# Longest the pool waits for a short rate-limit cooldown when nothing is available
# (Groq's free-tier token bucket has asked for 159s refills).
LLM_MAX_WAIT_SECONDS=300

# Groq (free tier, OpenAI-compatible; ~1000 req/day on openai/gpt-oss-20b as of 2026-09)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
# Reserved against Groq's 8,000 tokens/minute bucket: bigger = fewer calls per minute.
GROQ_MAX_OUTPUT_TOKENS=2048
# low | medium | high (gpt-oss reasoning budget). low = ~4x fewer tokens per call,
# which matters on the free tier's per-minute token limit; raise it if extraction
# recall matters more than throughput. Empty = model default.
GROQ_REASONING_EFFORT=low

# FAIR Free AI Router, embedded in-process (preferred). Install it from its repo:
#   pip install -e "C:\FAIR Free AI Router"
# It routes across every free provider it holds a key for and verifies each answer.
FAIR_ENABLED=true
# Free-only enforcement. When true, LLM_PROVIDER=auto refuses to fall back to the
# raw Gemini/Groq pool if FAIR is unusable (the raw pool bypasses FAIR's free-only
# check, so a key on a billable account could be charged); an LLM call fails
# closed instead. Leave false to allow the pool fallback.
FAIR_REQUIRED=false
# FAIR's own .env (Mistral, Cloudflare, OpenRouter, NVIDIA, ... keys). GEMINI_API_KEY
# and GROQ_API_KEY above are passed to FAIR as well.
FAIR_ENV_FILE=
FAIR_CLIENT_ID=corp
# Operator attestation that these FAIR provider accounts are free-only and cannot
# auto-bill; without it FAIR skips the keyed provider (see /providers/health).
# Comma-separated FAIR ids: google_gemini_api, groq, mistral, zai_free,
# cloudflare_workers_ai. OpenRouter Free and Kilo Free need no confirmation.
FAIR_CONFIRMED_FREE_PROVIDERS=
# Non-answers (down/slow/throttled) tolerated per solve before FAIR escalates.
FAIR_MAX_UNANSWERED_ATTEMPTS=6
# commodity | standard | advanced | high_impact_support. CORP's schema-validated
# answers pass at commodity/standard; advanced+ demands a deterministic check.
FAIR_QUALITY_LEVEL=standard
FAIR_PRIORITY=P2
FAIR_TIMEOUT_SECONDS=60
FAIR_MAX_OUTPUT_TOKENS=2048
FAIR_CACHE_ENABLED=true

# Google Gemini (free tier; also handed to FAIR)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Rate limits
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_REQUESTS_PER_SECOND=5

# yt-dlp metadata (YouTube fallback when YOUTUBE_API_KEY is empty; TikTok). No key needed.
YTDLP_MAX_ITEMS=50
YTDLP_INCLUDE_COMMENTS=false

# Creator-web adapter (platform "web", handle = URL of the creator hub/shop page)
WEB_MAX_PAGES=8

# Bulk research artifacts (raw JSONL archives from discovery runs). Point this at
# external storage (SD card / SSD); the database only stores a relative reference.
CORP_DATA_PATH=corp_data
# Windows flash-drive example (keep the drive plugged in during pipeline runs):
# CORP_DATA_PATH=D:\CORP DATABASE\archives

# SQLite warm store for bulk data. Point at a flash drive / external SSD to keep
# Supabase Postgres within the free-tier 500 MB limit. Pipelines write to both
# stores; the web dashboard reads only from Postgres.
WARM_STORE_PATH=corp_data/warm.db
# Windows flash-drive example. Format the drive exFAT or NTFS (FAT32 caps files at
# 4 GB and warm.db grows past that). If the drive is unplugged, warm writes are
# skipped with a warning rather than written to C:.
# WARM_STORE_PATH=D:\CORP DATABASE\warm.db

# Reddit (public .json feeds, no API key). Keep the interval >= 6s unauthenticated.
REDDIT_USER_AGENT=corp-research/0.1 (creator opportunity research)
REDDIT_POSTS_PER_CREATOR=25
REDDIT_REQUEST_INTERVAL_SECONDS=6

# Stack Exchange (niche-signal adapter). Fully open API; optional key raises
# quota from 300 to 10,000 requests/day. Register at https://stackapps.com.
# STACKEXCHANGE_SITE selects the site (stackoverflow, superuser, serverfault, etc.).
STACKEXCHANGE_API_KEY=
STACKEXCHANGE_SITE=stackoverflow
STACKEXCHANGE_MAX_QUESTIONS=50
STACKEXCHANGE_INCLUDE_ANSWERS=true

# Search-demand mining (niche-signal adapter). Google autocomplete suggestions
# as purchase-intent signals. No API key needed. Free, open, compliant.
SEARCHDEMAND_MAX_SUGGESTIONS=50
SEARCHDEMAND_LANGUAGE=en
SEARCHDEMAND_COUNTRY=us

# Amazon review mining (niche-signal adapter). 1-3 star reviews = unmet need +
# competitor weakness. Public pages, no API key. ComplianceStatus: VERIFY.
AMAZON_MAX_REVIEWS=50
AMAZON_MAX_PRODUCTS=5

# Marketplace listings (niche-signal adapter). Product listings for the §8
# saturation + pricing signals. ComplianceStatus: VERIFY.
MARKETPLACE_MAX_LISTINGS=30
# Default is Gumroad only. Udemy's Affiliate API was discontinued (2025-01-01)
# and Etsy's search is bot-blocked (DataDome); Etsy's official Open API requires
# an approved developer app, which is not currently available here, so Etsy is
# left out by default (ADR-0066). Add "etsy" back only once ETSY_API_KEY is set.
MARKETPLACE_SITES=gumroad
# Etsy Open API v3 key (Personal App tier). Etsy is only queried through the
# official API, never by scraping. Leave blank to skip Etsy entirely. When a key
# is set, "etsy" in MARKETPLACE_SITES is honoured and rows are tagged COMPLIANT.
# Register at https://www.etsy.com/developers (developer-app approval required).
ETSY_API_KEY=

# Hacker News (niche-signal adapter). Algolia Search API, fully open, no key needed.
# Stories + comments as audience-problem signals.
HACKERNEWS_MAX_ITEMS=50

# Wikipedia (niche-signal adapter). Pageview trends as demand-validation signal.
# Official Wikimedia API, fully open. Requires descriptive User-Agent (built-in).
WIKIPEDIA_MAX_ARTICLES=10
WIKIPEDIA_PAGEVIEW_DAYS=30

# Google Trends (niche-signal adapter). Trending Now RSS feed (compliant, no key).
# Optional: install pytrends-modern for interest-over-time data (tolerated).
GOOGLETRENDS_MAX_ITEMS=50
GOOGLETRENDS_GEO=US

# Apple App Store (niche-signal adapter). Review RSS + iTunes Search API.
# Open, no key needed. Reviews as unmet-need signals for mobile/software niches.
APPSTORE_MAX_REVIEWS=50
APPSTORE_MAX_APPS=5
APPSTORE_COUNTRY=us

# Source health tracker — circuit breaker for tolerated adapters (App Store RSS,
# pytrends, etc.). Tracks consecutive failures and disconnects sources that
# repeatedly fail. Disconnected sources are probed after a cooldown period.
HEALTH_DEGRADE_AFTER=3
HEALTH_DISCONNECT_AFTER=6
HEALTH_PROBE_COOLDOWN_SECONDS=3600

# Multi-source niche discovery — platforms to include in multi-source runs.
# Comma-separated. Empty = all niche-family adapters.
NICHE_DISCOVERY_PLATFORMS=

# Scoring
SCORING_RULES_PATH=rules/scoring.yaml
INTENT_RULES_PATH=rules/intent.yaml
BROAD_TOPICS_PATH=rules/broad_topics.yaml

# Autonomous discovery crawler (CORP1 Step 1, Level 0)
# Off by default: when true, the API runs a discovery pass on a timer with
# no user input -- trend scan, recursive niche drill-down, qualification.
# Each pass spends LLM quota per seed topic, so this is an explicit opt-in.
# POST /discovery/run triggers one pass by hand whether or not this is set,
# which is the intended way to watch a pass (and its cost) before enabling
# the timer. Needs GEMINI_API_KEY or GROQ_API_KEY to do anything.
DISCOVERY_ENABLED=false
# Seconds between passes (86400 = daily).
DISCOVERY_INTERVAL_SECONDS=86400
# Seed topics drilled per pass. Leave blank to use topics_per_pass from
# rules/broad_topics.yaml (3). The main cost lever.
#DISCOVERY_TOPICS_PER_PASS=3
# Where topic momentum comes from: youtube | googletrends | none.
#   youtube      — official Data API trending charts; needs YOUTUBE_API_KEY.
#                  About 15-30 quota units per pass, from the same daily
#                  quota creator onboarding uses.
#   googletrends — trending RSS + pytrends (unofficial; pytrends is not
#                  installed by default, and without it few topics match).
#   none         — rank by least-recently-researched only.
# With the source's prerequisites missing, ranking falls back to rotation.
# GET /discovery/status reports which one is actually in effect.
DISCOVERY_MOMENTUM_SOURCE=youtube

# App
APP_ENV=development
LOG_LEVEL=INFO

# API server
API_PORT=8010
# Required in non-development environments. When empty (the default), all
# endpoints are unauthenticated — only safe for local development.
API_KEY=
# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
